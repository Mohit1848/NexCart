# ==============================================================================
# NEXCART - Root Environment Template
# ==============================================================================
# Copy this file to server/.env and fill in your local secrets.
# NEVER commit .env to version control!

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexcart_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_random_key_nexcart_2026
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Optional integrations (Later phases)
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
